&CONTROL
 calculation = 'scf'
 prefix = 'mgo_example'
 pseudo_dir = './pseudo'
 outdir = './outdir'
/
&SYSTEM
 ibrav = 1
  celldm(1) = 8.0
  nat = 2
  ntyp = 2
  ecutwfc = 50.0
/
&ELECTRONS
 conv_thr = 1.0d-8
/
ATOMIC_SPECIES
Mg 24.305 Mg.upf
O 15.999 O.upf
ATOMIC_POSITIONS angstrom
Mg 0.0 0.0 0.0
O 2.0 2.0 2.0
K_POINTS gamma
